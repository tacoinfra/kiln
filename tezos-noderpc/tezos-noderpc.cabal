name: tezos-noderpc
version: 0.1.1.0
license: BSD3
copyright: Copyright (C) Obsidian Systems LLC 2018
author: Obsidian Systems
maintainer: maintainer@obsidian.systems
stability: Experimental
build-type: Simple
cabal-version: >=1.8

library
  exposed-modules:
    Tezos.History
    Tezos.NodeRPC
    Tezos.NodeRPC.Helpers
    Tezos.NodeRPC.Network
    Tezos.Signature.Verify
  other-modules:
    Paths_tezos_noderpc
  -- other-extensions:
  build-depends:
      base >=4.11 && <5
    , aeson
    , bytestring
    , containers
    , cryptonite
    , deepseq
    , dependent-sum
    , http-client
    , http-types
    , lens
    , memory
    , micro-ecc
    , modern-uri
    , monad-logger
    , mtl
    , safe-exceptions
    , stm
    , text
    , tezos-bake-monitor-lib
    , time
  hs-source-dirs:      src
  default-language:    Haskell2010

executable tezos-noderpc-smoketest
  main-is: Test.hs
  hs-source-dirs: src-bin
  build-depends:
      base
    , containers
    , http-client
    , http-client-tls
    , lens
    , monad-logger
    , mtl
    , stm
    , text
    , tezos-bake-monitor-lib
    , tezos-noderpc
  default-language: Haskell2010
  ghc-options: -Wall -Werror
