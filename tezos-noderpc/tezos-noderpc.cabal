-- Initial tezos-noderpc.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                tezos-noderpc
version:             0.1.0.0
-- synopsis:
-- description:
license:             BSD3
license-file:        LICENSE
author:              dbornside
maintainer:          dan.bornside@obsidian.systems
-- copyright:
-- category:
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

library
  exposed-modules:
    Tezos.History
    Tezos.NodeRPC
    Tezos.NodeRPC.Network
  other-modules:
    Paths_tezos_noderpc
  -- other-extensions:
  build-depends:
      base >=4.11 && <5
    , modern-uri
    , tezos-bake-monitor-lib
    , containers
    , safe-exceptions
    , lens
    , mtl
    , monad-logger
    , text
    , http-client
    , http-types
    , aeson
    , bytestring
  hs-source-dirs:      src
  default-language:    Haskell2010

executable tezos-noderpc-smoketest
  main-is: Test.hs
  hs-source-dirs: src-bin
  build-depends:
      base
    , containers
    , http-client
    , http-client-tls
    , lens
    , monad-logger
    , mtl
    , terminal-progress-bar
    , text
    , tezos-bake-monitor-lib
    , tezos-noderpc
  default-language: Haskell2010
  ghc-options: -Wall -Werror
