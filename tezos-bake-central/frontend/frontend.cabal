name: frontend
version: 0.1
license: BSD3
copyright: Copyright (C) Obsidian Systems LLC 2018
author: Obsidian Systems LLC
maintainer: maintainer@obsidian.systems
stability: Experimental
build-type: Simple
cabal-version: >=1.8

library
  hs-source-dirs: src

  exposed-modules:
    Frontend

  other-modules:
    Frontend.Common

  build-depends:
      base
    , bytestring
    , base16-bytestring
    , either
    , common
    , containers
    , data-default
    , file-embed
    , ghcjs-dom
    , lens
    , mtl
    , obelisk-executable-config
    , reflex
    , reflex-dom-core
    , reflex-dom-forms
    , rhyolite-common
    , rhyolite-frontend
    , semantic-reflex
    , text
    , these
    , time

  ghc-options: -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -rtsopts -fexpose-all-unfoldings


executable frontend
  main-is: main.hs
  hs-source-dirs: src-bin
  build-depends: base
               , reflex-dom
               , frontend
  ghc-options: -threaded
  if os(darwin)
     ghc-options: -dynamic
