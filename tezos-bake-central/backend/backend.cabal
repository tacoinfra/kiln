    , semigroupoids
    , shelly
    , snap-core
    , snap-loader-static
    , snap-server
    , stm
    , svg-builder
    , template-haskell
    , temporary
    , text
    , tezos-bake-monitor-lib
    , tezos-noderpc
    , these
    , time
    , transformers
    , transformers-base
    , unix
    , universe
    , unordered-containers
    , uri-encode
    , vector
    , witherable

  exposed-modules:
    Backend

  other-modules:
    Paths_backend
    Backend.Alerts
    Backend.Alerts.Common
    Backend.CachedNodeRPC
    Backend.Common
    Backend.Config
    --Backend.Graphs
    Backend.Http
    Backend.IndexQueries
    Backend.Migrations
    Backend.NodeCmd
    Backend.NotifyHandler
    Backend.RequestHandler
    Backend.Schema
    Backend.Snapshot
    Backend.STM
    Backend.Supervisor
    Backend.Telegram
    Backend.Upgrade
    Backend.Version
    Backend.ViewSelectorHandler
    Backend.WebApi
    Backend.Workers.Accusation
    Backend.Workers.Baker
    Backend.Workers.Block
    Backend.Workers.Cache
    Backend.Workers.Node
    Backend.Workers.Process
    Backend.Workers.TezosClient
    System.Which

  ghc-options: -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -fexpose-all-unfoldings
  cpp-options: -DREAL_BUILD

executable backend
  hs-source-dirs: src-bin
  main-is: Main.hs

  build-depends:
      base
    , backend
    , obelisk-backend

  ghc-options: -threaded -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -rtsopts -fexpose-all-unfoldings
