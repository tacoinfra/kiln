  build-depends:
      aeson
    , async
    , backend-db
    , base
    , base16-bytestring
    , base58-bytestring
    , bytestring
    -- , Chart
    -- , Chart-diagrams
    , clientsession
    , colour
    , common
    , constraints
    , constraints-extras
    , containers
    , data-default
    , dependent-map
    , dependent-sum
    , dependent-sum-template
    , directory
