    -- , diagrams-lib
    -- , diagrams-svg
    , exceptions
    , filepath
    , formatting
    , frontend
    , functor-infix
    , generic-deriving
    , groundhog
    , groundhog-postgresql
    , groundhog-th
    , here
    , hashable
    , http-client
    , http-client-tls
    , http-conduit
    , http-types
    , io-streams
    , IntervalMap
    , lattices
    , lens
    , lens-aeson
    , mime-mail
    , modern-uri
    , monad-control
    , monad-logger
    , monoidal-containers
    , mtl
    , named == 0.3.*
    , network
    , obelisk-asset-serve-snap
    , obelisk-backend
    , obelisk-backend
    , obelisk-executable-config-inject
    , obelisk-frontend
    , obelisk-route
    , postgresql-simple
    , process
    , random-extras
    , random-fu
    , reflex
    , reflex-dom-core
    , resource-pool
    , rhyolite-backend
    , rhyolite-backend-db
    , rhyolite-backend-snap
    , rhyolite-common
    , safe
