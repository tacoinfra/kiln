name: backend
version: 0.1
license: BSD3
copyright: Copyright (C) Obsidian Systems LLC 2018
author: Obsidian Systems LLC
maintainer: maintainer@obsidian.systems
stability: Experimental
build-type: Simple
cabal-version: >=1.8

library
  hs-source-dirs: src

  build-depends:
      aeson
    , tezos-bake-monitor-lib
    , base
    , bytestring
    , base16-bytestring
    , Chart
    , Chart-diagrams
    , clientsession
    , colour
    , common
    , containers
    , data-default
    , dependent-map
    , dependent-sum-template
    , diagrams-core
    , diagrams-lib
    , diagrams-svg
    , either
    , filepath
    , frontend
    , groundhog
    , groundhog-postgresql
    , groundhog-th
    , http-client
    , http-client-tls
    , http-conduit
    , http-types
    , lens
    , lens-aeson
    , mime-mail
    , modern-uri
    , monad-control
    , monad-logger
    , mtl
    , network
    , obelisk-asset-serve-snap
    , obelisk-executable-config-inject
    , postgresql-simple
    , reflex
    , reflex-dom-core
    , resource-pool
    , rhyolite-backend
    , rhyolite-backend-snap
    , rhyolite-common
    , safe
    , safe-exceptions
    , say
    , snap-core
    , snap-loader-static
    , snap-server
    , stm
    , svg-builder
    , text
    , time

  exposed-modules:
    Backend

  other-modules:
    Backend.Workers
    Backend.Workers.Node
    Backend.Workers.Client
    Backend.Workers.Delegate
    Backend.CachedNodeRPC
    Backend.BalanceTracking
    Backend.ChainHealth
    Backend.Config
    Backend.Errors
    Backend.Graphs
    Backend.NotifyHandler
    Backend.RequestHandler
    Backend.Schema
    Backend.ViewSelectorHandler

  ghc-options: -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -rtsopts -fexpose-all-unfoldings

executable backend
  hs-source-dirs: src-bin
  main-is: main.hs

  build-depends:
      base
    , backend

  ghc-options: -threaded -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -rtsopts -fexpose-all-unfoldings

