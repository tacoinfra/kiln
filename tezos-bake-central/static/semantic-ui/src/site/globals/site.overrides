/*******************************
     Site Overrides
*******************************/

._link-like() {
  cursor: pointer;
  &:hover {
    color: @hoverBlue;
  }
  &:active {
    color: @activeBlue;
  }
}

.fine-print() {
  line-height: @16px;
  font-size: @12px;
}

.secondary-heading() {
  font-size: @20px;
  font-weight: normal;
}

a:link {
  color:@blue;
  text-decoration-line:none;
}
a:visited {
  color: @visitedBlue;
  text-decoration-line:none;
}
a:hover {
  text-decoration-line:underline;
  color: @hoverBlue;
}
a:active {
  color: @activeBlue;
  text-decoration-line:none;
}
.aside {color: @grey;}

h6.ui.header {
  font-size: @relative13px;
}

._modal-base() {
  // This isn't necessary for our modals, but some common pesky plugins
  // put overlays on the screen with z-index and we want to beat them.
  // This is the smallest number that works for the following plugins:
  //   * LastPass
  z-index: 20;
}

.modal-backdrop {
  ._modal-base();

  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;

  &.disconnected {
    background-color: rgba(0,0,0,0.2);
  }
}

.modal-box {
  ._modal-base();

  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-width: 100%;
  max-height: 100%;
  background-color: #FFF;
  box-shadow: 0 @15px @40px 0 rgba(0,0,0,0.2);

  > .content {
    padding: @50px;

    > p {
      margin-top: @20px;
    }

    .buttons {
      text-align: center;
      margin-top: @30px;

      .ui.button.primary.close {
        width: unit(166 / @emSize, rem);
      }
    }
  }

  > .modal-close {
    ._link-like();
    padding: @10px;
    height: @30px;
    width: @30px;
    float: right;

    > i.fitted {
      transform: translate(-@2px, -@2px);
    }
  }
}

.secondary-name {
  font-size: @12px;
  font-weight: normal;
  color: @grey;
  overflow: hidden;
  text-overflow: ellipsis;
}

.faded {
  opacity: 0.50;
}

.ui.publicnodes {
  > .public-node.grid {
    border: @1px solid #CED4DA;
    background: white;
    border-radius: @borderRadius;
    cursor: pointer;

    &:hover {
      box-shadow: 0 @4px @12px 0 rgba(0,0,0,0.1);
    }

    &@{moreMagic5} {
      margin-bottom: @15px !important;
    }

    > .row {
      align-items: center;
    }
  }

  > .active .ui.icon.header {
    color: #a6a6a6;
  }

  .ui.icon.header {
    font-size: @14px;
    font-weight: 500;
    color: @primaryColor;

    > i.icon {
      font-size: @25px;
    }
  }

  .header {
    font-weight: bold;
  }
}

.telegram-setup {
  line-height: @19px;

  .error {
    padding-left: @50px;
    padding-right: @50px;
    padding-top: 0;
  }

  li {
    padding-bottom: 1.5em; // TODO: Don't use 'em'
  }

  p {
    padding-top: 1em; // TODO: Don't use 'em'
  }
}

.suggested-fix {
  color: @grey;
  font-size: 90%;
  padding-bottom: @12px;

  > .heading {
    font-weight: bold;
    display: inline;

    &:after {
      content: ": ";
    }
  }

  > .content {
    display: inline;
  }
}

.block-level-error, .block-level-error > a {
  color: #c00;
  font-weight: bold;
}

body {
  height: 100%;
  width: 100%;
}

.app-frame {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}

.app-sidebar {
  width: unit(220 / @emSize, rem);
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  background: @sidebarBackground;

  // .ui.basic.segment sets a transparent background
  &.ui.basic.segment {
    background: @sidebarBackground;
  }

  > .ui.basic.segment {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: unit(30 / @emSize, rem);
    padding-right: unit(30 / @emSize, rem);
    padding-top: 0;
    padding-bottom: 0;
  }

  .app-side-header {
    margin-bottom: 0;
    padding-bottom: 0;

    img.app-logo {
      width: auto;
      margin-right: 0.5em;
      margin-top: 1em;
    }

    .ui.header {
      font-size: unit(22 / @emSize, rem);
    }

    > .ui.vertical.menu {
      margin-top: unit(40 / @emSize, rem);
      margin-bottom: unit(30 / @emSize, rem);
      > .link.item:only-child {
        background-color: @white;
        border: solid @1px @grey;
        border-radius: @3px;
        box-shadow: 0 @2px @6px 0 rgba(0, 0, 0, 0.1);

        &.active {
          border-color: @blue;
        }
      }
    }
  }
}

.pusher {
  display: flex;
  flex-direction: column;
  height: 100%;

  .ui.segment.vertical.primary {
    padding-top: @6px;
    padding-bottom: @6px;
    padding-right: @20px;
    border-bottom-width: @2px;

    .column {
      .ui.circular.label.link {
        cursor: pointer;
        height: @40px;
        font-size: 16px;
        margin-top: 2px;
        &.basic {
          border-color: transparent;
        }
      }
    }

    .topbar.column {
      padding-left: @30px;
      display: flex;
      align-items: center;

      > .ui.horizontal.list .item .content {
        font-weight: bold;
        font-size: @13px;
        padding-left: @30px;
        margin-right: @40px;

        .metadescription {
          font-weight: normal;
        }
        > .header {
          font-size: @12px;
          font-weight: normal;
          color: rgba(0, 0, 0, .6);
          padding-bottom: @4px;
        }
      }

      .disconnected-tooltip {
        width: 260px;
        white-space: normal;

        p {
          margin-bottom: @7px;
        }

        .tooltip-title {
          font-weight: bold;
          font-size: @13px;
        }

        .tooltip-description {
          color: @grey;
          font-size: @12px;

          .icon.circle {
            margin-left: @8px;
            margin-right: @8px;
          }
        }
      }
    }
  }
}

.app-header {
}

.app-content {
  flex-grow: 1;
  &:not(.app-welcome) {
    padding-left: @30px;
    padding-right: @30px;
  }
  overflow: auto;

  &.app-welcome {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }

  h4 {
    margin-bottom: @30px;
  }
}

.ui.segment.app-gutter {
  padding-left: @30px;
  flex-grow: 1;
  overflow-x: hidden;
  overflow-y: auto;
  > .ui.sub.header , > .ui.list > .item {
    margin-top: @12px;
    margin-bottom: @12px;
    padding-top: 0;
    padding-bottom: 0;
    max-width: 100%;
  }
  > .ui.list > .item > .content {
    display: block;
    .header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;

      .title {
        display: block;
        text-overflow: ellipsis;
        overflow-x: hidden;
      }
      img {
        height: @10px;
      }
      .ui.bottom.right.popup:before {
        right: @5px;
      }
    }
    .description {
      overflow-x: hidden;
      text-overflow: ellipsis;
    }
  }
  > .ui.button {
    margin-top: @14px;
    margin-bottom: @14px;
  }
  .ui.sub.header {
    color: @grey;
    font-weight: normal;
  }
}

.ui.segment.app-side-footer {
  > .ui.vertical.menu {
    margin-left: -@10px;
    margin-right: -@10px;
    width: calc(100% ~"+" @20px);
    > .link.item:only-child {
      font-size: @13px;
      line-height: @18px;
      padding-left: @10px;
      padding-right: @10px;
      padding-top: @5px;
      padding-bottom: @5px;
      .icon {
        margin-top: unit(2.5 / @emSize, rem);
      }
    }
  }
}


.app-right {
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-grow: 1;

  .ui.sidebar.vertical.menu {
    @sidebar-horizontal-padding: @30px;
    padding: @20px @sidebar-horizontal-padding;
    display: flex;

    .sidebar-title {
      padding-bottom: @10px;
      .header.floated {
        font-size: @20px;
        margin-right: 0;
        > .icon {
          ._link-like();
          font-size: @25px;
          margin-right: 0;
        }
      }
    }

    .divider {
      margin-top: @15px;
      margin-bottom: @20px;
      margin-left: -@sidebar-horizontal-padding;
      margin-right: -@sidebar-horizontal-padding;
      border-top-width: @2px;
    }

    .no-notifications {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
      color: @grey;
      font-size: @20px;
    }

    .ui.segment.vertical.app-notifications-list {
      padding-top: 0;

      .ui.message.app-notification {
        display: flex;
        flex-direction: column;

        > * {
          margin-top: @3px;
          margin-bottom: @3px;
        }

        .positive, .success, .negative, .error {
          &, & .header {
            color: @black;
          }
        }

        label {
          font-weight: bold;
          margin-right: 1em;
        }

        .secondary-label {
          font-weight: normal;
          font-style: italic;
          color: @grey;
        }
      }
    }
  }
}

/* .ui.header > img sets a vertical-align */
.ui.header > img.app-logo {
  height: 0.74em; // TODO: Don't use 'em'
  vertical-align: baseline;
}

img.credits-obsidian {
  width: unit( (110 / @emSize), rem);
  background: white;
  border-color: white;
  border-radius: @2px;
  border-style: solid;
  border-width: @5px @10px;
  margin-left: @7px;
}

.notifications-subsection {
  > .ui.header > .ui.toggle label {
    > .icon {
      margin-left: 1em;
      margin-right: 1em;
    }
    .secondary-heading();
    margin-top: @20px;
    margin-bottom: @20px;
  }
  > .edit-link {
    margin-top: @15px;
    margin-bottom: @15px;

    a {
      cursor: pointer;
    }
  }
  margin-top: @30px;
  margin-bottom: @30px;

  .small.ui.header + .notification-settings-description {
    margin-top: @10px;
  }

  .notification-settings-description {
    .fine-print();
    font-size: @12px;
    margin-top: @30px;
    margin-bottom: @20px;
  }

  .ui.button.fluid {
    width: 200px;
  }

  .ui.form .fields {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: @10px;

    .inline.field {
      padding-left: 0;
      padding-right: 0;
      margin-right: @20px;
    }

    .field.wide {
      padding-left: 0;
      padding-right: 0;
      margin-right: @30px;

      input {
        padding-left: @10px;
        padding-right: @15px;
      }

      i.dropdown.icon {
        color: @blue;
        font-size: @20px;
        padding: @7px;
      }
    }

    .email-buttons {
      > a.remove {
        cursor: pointer;
        font-weight: bold;

        &:hover {
          text-decoration: none;
        }
      }

      > a.send-test {
        cursor: pointer;
        margin-left: @20px;
      }
    }
  }
}

.settings-table {
  margin-top: @15px;
  margin-bottom: @15px;

  td, th {
    text-align: left;
    vertical-align: top;
    // No way to do interior-only border-spacing, so instead use this on
    // successive children. Use padding because no margin on table cells.
    padding-left: @40px;
  }
  // `rowspan` means `:first-child` doesn't indicate visually first cell of row.
  // Use `.visually-second` on such second column first children as a
  // workaround.
  td:first-child:not(.visually-second), th:first-child:not(.visually-second) {
    padding-left: 0px;
  }
}

.soft-heading {
  .secondary-heading();
}

.version-section {
  margin-top: @35px;
  > .check-for-updates {
    padding-top: @10px;

    > a {
      cursor: pointer;
      padding-right: @27px;
    }
  }
}

.notifications-section {
  > .ui.header:first-child {
    margin-top: @64px;
  }
}

.ui.list > .item.bullet-before {
  position: relative;

  > .icon.circle.tiny {
    position: absolute;
    right: 100%;
    margin-right: @7px;
    line-height: 2.4em; // To position the dot correctly.
  }

  > .icon + .content {
    padding-left: 0;
  }
}

.ui.form {
  .feedback {
    margin-top: @30px;
    margin-bottom: @15px;

    i {
      margin-right: @10px;
      font-size: @15px;
      font-weight: bold;
    }
  }
}

.ui.loader.blue {
  &:after {
    border-top-color: @blue;
  }
  &:before {
    border-color: fade(@blue, 10%);
  }
}

.dashboard-section > .dashboard-section-overview {
  display: flex;

  .dashboard-section-overview-icon {
    .icon {
      margin-right: @24px;
    }
  }

  .dashboard-section-overview-body {
    flex: 1;

    .ui.header {
      margin-bottom: @13px;

      .ui.loader {
        margin-right: @10px;
      }
    }

    .description {
      color: @grey;

      .buttons {
        display: flex;
        justify-content: flex-end;
      }
    }
  }
}

.dashboard-section > .ui.cards {
  margin-left: 0;
  margin-right: 0;

  > .ui.card.node-tile {
    width: unit(200 / @emSize, rem);

    .internal-node-subtitle {
      display: flex;
      margin-top: @4px;

      img {
        height: @10px;
        margin-right: @10px;
        font-size: @10px;
      }
      div {
        height: @10px;
      }
    }

    .internal-node-tile-body {
      .ui.row {
        margin-top: @15px;
        margin-bottom: @15px;

        i.icon-id-badge {
          color: #d8dce6;
        }
      }
    }
  }

  > .ui.card.baker-tile {
    width: unit(280 / @emSize, rem);

    .ui.loader {
      margin-right: @6px;
    }
  }

  > .ui.card.dashboard-tile {
    box-shadow: none;

    margin-left: 0;
    margin-right: @30px;

    > .content {
      flex-grow: 0;

      padding-left: @15px;
      padding-right: @15px;
      padding-top: @2px;
      padding-bottom: @17px;

      border-radius: @2px !important;
      border: solid @1px #cacaca !important;

      font-size: @12px;
      line-height: 1.5;

      > .menu-section {
        text-align: right;

        .icon {
          ._link-like();
          font-size: @20px;
          color: @grey;
          margin: 0;
        }

        .ui.popup {
          top: @15px;
          right: -@32px;

          > .link.list .item {
            ._link-like();
            color: @blue;
            font-size: @14px;
            line-height: 2.86;
          }
        }
      }

      > .title {
        font-size: @14px;
        font-weight: bold;
        line-height: 1.3;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;

        .circle.icon {
          font-size: @8px;
          vertical-align: 15%;
        }
      }

      > .ui.error.message {
        margin-top: @10px;
        font-weight: bold;
        font-size: @13px;
        color: black;
        line-height: 1;

        padding-top: @12px;
        padding-bottom: @11px;  // Because it doesn't look right without this.
        padding-left: @12px;
        padding-right: @12px;

        border-radius: @3px;
        border: solid @1px #ff0000;
        box-shadow: none;
        background-color: #fff5f5;
      }

      > .divider {
        width: unit(170 / @emSize, rem);
        height: @1px;
        background-color: #eaeaea;
        margin-top: @10px;
        margin-bottom: @7px;
      }

      dl {
        margin-block-start: 0;
        margin-block-end: 0;

        > div {
          > dt {
            display: inline;
          }

          > dt::after {
            content: ":";
          }

          > dd {
            font-weight: bold;
            display: inline;
            margin-inline-start: @5px;
          }
        }
      }

      > .peer-count {
        font-size: @16px;
      }

      > .stats {
        display: flex;
        flex-wrap: wrap;
        flex-direction: row;
        justify-content: space-between;
        margin: 0;
        padding: 0;

        .icon {
          margin-right: 0;
          font-size: @9px;
          color: @grey;
        }

        > .column {
          display: flex;
          flex-direction: column;

          &.heading {
            color: @grey;
            text-align: right;
          }

          > .cell {
            box-sizing: border-box;
            overflow: hidden; // Or flex might break
            list-style: none;
            border: none;
          }
        }
      }
    }
  }
}

h4.dashboard-section-title {
  text-transform: uppercase;
  margin-top: @20px;
  margin-bottom: @20px;
  color: @slate;
  font-size: @14px;
}

.explanation {
  color: @grey;
  font-size: @12px;
}

.modal-box > .content {
  > .ui.header {
    margin-bottom: @30px;
  }

  > .ui.grid {

    > .column:not(:first-child) {
      padding-left: 30px;
    }
    > .column:not(:last-child) {
      padding-right: 30px;
    }

    .add-internal {
      width: unit(279 / @emSize, rem);
    }

    .add-external {
      width: unit(305 / @emSize, rem);
    }

    .add-public {
      width: unit(379 / @emSize, rem);
    }

    .column > .ui.header {
      margin-bottom: @10px;
      font-weight: normal;
    }

    .explanation {
      margin-top: @5px;
      margin-bottom: @20px;
      lineHeight: @16px;
    }
  }
}

.modal-box.add-baker {
  width: unit(500 / @emSize, rem);
  max-width: 95%;

  h3 {
    font-size: unit(24 / @emSize, rem);
    margin-bottom: @10px;
  }

  .basic.small.segment {
    margin-top: @10px;
    margin-bottom: @20px;
  }

  .ui.button.primary {
    margin-top: unit(40 / @emSize, rem);
    /* TODO make this padding standard for all primary buttons? */
    padding-left: unit(50 / @emSize, rem);
    padding-right: unit(50 / @emSize, rem);
    margin-left: auto;
    margin-right: auto;
    display: block;
  }
}

.modal-box.add-node {
  width: unit(1039 / @emSize, rem);

  .ui.button.primary {
    display: inline-block;
    width: 100%;
  }
}

.dashboard-section.dashboard-section-global-alerts {
  margin-left: @30px;
  margin-right: @30px;
  margin-top: @30px;
}

/* vim: set syntax=less : */
