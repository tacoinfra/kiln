/*******************************
         Site Overrides
*******************************/

.fine-print() {
  line-height: @16px;
  font-size: @12px;
}

.secondary-heading() {
  font-size: @20px;
  font-weight: normal;
}

a:link {
    color:@blue;
    text-decoration-line:none;
}
a:visited {
    color: @visitedBlue;
    text-decoration-line:none;
}
a:hover {
    text-decoration-line:underline;
    color: @hoverBlue;
}
a:active {
    color: @activeBlue;
    text-decoration-line:none;
}
.aside {color:@grey;}

h6.ui.header {
    font-size:@relative13px;
}

._modal-base {
    // This isn't necessary for our modals, but some common pesky plugins
    // put overlays on the screen with z-index and we want to beat them.
    // This is the smallest number that works for the following plugins:
    //   * LastPass
    z-index: 20;
}

.modal-backdrop {
    ._modal-base;

    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;

    &.disconnected {
        background-color: rgba(0,0,0,0.2);
    }
}

.modal-box {
    ._modal-base;

    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    max-width: 100%;
    max-height: 100%;
    background-color: #FFF;
    box-shadow: 0 15px 40px 0 rgba(0,0,0,0.2);

    & > .content {
        padding: 50px;
    }
}

.modal-box > .modal-close {
    padding: @10px;
    height: @30px;
    width: @30px;
    float: right;
    cursor: pointer;

    &:hover {
        color: @hoverBlue;
    }
    &:active {
        color: @activeBlue;
    }
    & > i.fitted {
        transform: translate(-2px, -2px);
    }
}


.shaded{
    padding:@15px;
}

.shaded.grey { background-color:@blue; }
.shaded.blue { background-color:#f8f9fc; }

.ui.publicnodes .ui.icon.header > i.icon {
    font-size:@25px;
}

.ui.publicnodes > .grid > .row {
  align-items:center;
}

.ui.publicnodes > .grid {
    border: 1px solid #CED4DA;
    background:white;
    border-radius: @borderRadius;
}
.ui.publicnodes > .grid@{moreMagic5} {
    margin-bottom: @15px!important;
}
.ui.publicnodes > .active .ui.icon.header {
    color:#a6a6a6;
}

.ui.publicnodes .ui.icon.header {
    font-size:@14px;
    font-weight:500;
    color:@primaryColor;
}

.ui.publicnodes .header {
    font-weight:bold;
}

.ui.list.publicnodes > .item:not(.active) > .icon {
    content:'Add Node';
}
.ui.list.publicnodes > .item.active > .icon {
    content:'Added';
}
.ui.list.publicnodes > .item.active > .content {
}

.topbar {
    padding-left: @30px;

    & .ui.horizontal.list .item .content {
        font-weight: bold;
        padding-left: @30px;

        & .item .content .header {
            font-weight: normal;
            color: rgba(0, 0, 0, .6);
            padding-bottom: @4px;
        }
    }
}

.telegram-setup {
    line-height: 19px;

    & .error {
        padding-left: @50px;
        padding-right: @50px;
        padding-top: 0px;
    }

    & li {
        padding-bottom: 1.5em;
    }

    & p {
        padding-top: 1em;
    }
}

.suggested-fix {
    color: #898989;
    font-size: 90%;
    padding-bottom: @12px;

    & > .heading {
        font-weight: bold;
        display: inline;

        &:after {
            content: ": ";
        }
    }
    & > .content {
        display: inline;
    }
}

.block-level-error, .block-level-error > a {
  color: #c00;
  font-weight: bold;
}

body {
  height: 100%;
  width: 100%;
}

.app-frame {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}

.app-right {
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.app-sidebar {
  width: 220px;
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  background: #f5f5f5;
}

/* .ui.basic.segment sets a transparent background */
.ui.basic.segment.app-sidebar {
  background: #f5f5f5;
}

.pusher {
  display: flex;
  flex-direction: column
}

.app-header {
}

.app-content {
  flex-grow: 1;
  padding-left: @30px;
  padding-top: @35px;
  overflow: auto;

  & .ui.stackable.cards {
    margin-left: 0;
    margin-right: 0;
  }
}

.ui.segment.app-side-header {
  margin-bottom: 0;
  padding-bottom: 0;
}

.ui.segment.app-gutter {
  padding-left: @30px;
  flex-grow: 1;
  margin-top: 0;
  margin-bottom: 0;
  overflow: auto;
}

.ui.segment.app-side-footer {
  margin-top: 0;
  padding-top: 0;
}

/* .ui.header > img sets a vertical-align */
.ui.header > img.app-logo {
  height: 0.74em;
  vertical-align: baseline;
}

.app-welcome {
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
}

img.credits-obsidian {
  width: 60%;
  background: white;
  border-color: white;
  border-radius: @2px;
  border-style: solid;
  border-width: @5px @10px;
  margin-left: 20%;
  margin-right: 20%;
}

.notifications-subsection {
  > .ui.header > .ui.toggle label {
    > .icon {
      margin-left: 1em;
      margin-right: 1em;
    }
    .secondary-heading();
    margin-top: @20px;
    margin-bottom: @20px;
  }
  > .purpose {
    .fine-print();
    margin-top: @10px;
    margin-bottom: @10px;
  }
  > .edit-link {
    margin-top: @15px;
    margin-bottom: @15px;
  }
  margin-top: @30px;
  margin-bottom: @30px;
}

.telegram-recipients {
  td, th {
    text-align: left;
  }
  .telegram-recipient {
    padding-right: @40px;
  }
}

.soft-heading {
    font-size: @20px;
    font-weight: normal;
}

.version-section {
    & > .check-for-updates {
        padding-top: @10px;

        & > a {
            cursor: pointer;
            padding-right: @27px;
        }
    }
}

.ui.list > .item.bullet-before {
    position: relative;

    > .icon.circle.tiny {
        position: absolute;
        right: 100%;
        margin-right: @7px;
        line-height: 2.4em; // To position the dot correctly.
    }

    > .icon + .content {
        padding-left: 0;
    }
}

/* vim: set syntax=less : */
