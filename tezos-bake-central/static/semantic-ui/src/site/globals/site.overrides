/*******************************
     Site Overrides
*******************************/

._link-like() {
  cursor: pointer;
  &:hover {
    color: @hoverBlue;
  }
  &:active {
    color: @activeBlue;
  }
}

.fine-print() {
  line-height: @16px;
  font-size: @12px;
}

.secondary-heading() {
  font-size: @20px;
  font-weight: normal;
}

a:link {
  color:@blue;
  text-decoration-line:none;
}
a:visited {
  color: @visitedBlue;
  text-decoration-line:none;
}
a:hover {
  text-decoration-line:underline;
  color: @hoverBlue;
}
a:active {
  color: @activeBlue;
  text-decoration-line:none;
}
.aside {color: @grey;}

h6.ui.header {
  font-size: @relative13px;
}

._modal-base() {
  // This isn't necessary for our modals, but some common pesky plugins
  // put overlays on the screen with z-index and we want to beat them.
  // This is the smallest number that works for the following plugins:
  //   * LastPass
  z-index: 20;
}

.modal-backdrop {
  ._modal-base();

  position: fixed;
  top: 0;
  left: 0;
  height: 100%;
  width: 100%;

  &.disconnected {
    background-color: rgba(0,0,0,0.2);
  }
}

.modal-box {
  ._modal-base();

  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  max-height: 100%;
  background-color: #FFF;
  box-shadow: 0 @15px @40px 0 rgba(0,0,0,0.2);

  > .content {
    padding: @50px;

    > p {
      margin-top: @20px;
    }

    .buttons {
      text-align: center;
      margin-top: @30px;

      .ui.button.primary.close {
        width: unit(166 / @emSize, rem);
      }
    }
  }
}

.modal-close {
  ._link-like();
  padding: @10px;
  height: @30px;
  width: @30px;
  float: right;

  > i.fitted {
    transform: translate(-@2px, -@2px);
  }
}

.secondary-name {
  font-size: @12px;
  font-weight: normal;
  color: @grey;
  overflow: hidden;
  text-overflow: ellipsis;
}

.faded {
  opacity: 0.50;
}

.vote-modal {
  min-width: 700px;
  .detail {
    font-size: @12px;
    color: #6a6a6a;
  }
  .header {
    margin-bottom: @10px;
    font-size: @24px;
    font-weight: bold;
    > .icon {
      vertical-align: -@2px;
      margin-right: @8px;
    }
    > .detail {
      font-weight: normal;
      margin-left: @20px;
    }
  }
  .bigtitle {
    .icon {
      margin: 0 @20px @4px 0;
    }
    padding: @20px;
    font-size: @20px;
    font-weight: bold;
    text-align: center;
  }
  .centered-grey {
    text-align: center;
    color: @grey;
  }
  .cast-vote-protocol {
    margin-bottom: @30px;
    font-size: @16px;
    font-weight: bold;
    text-align: center;
  }
  .confirm-title {
    margin-top: @30px;
    font-size: @16px;
    font-weight: bold;
    text-align: center;
  }
  .confirm-content {
    margin-top: @10px;
    font-size: @16px;
    font-weight: bold;
    text-align: center;
  }
  .looking-tezos-wallet {
    .header {
      font-size: @20px;
      padding: @10px;
    }
    .ui.active.inline.loader {
      margin-right: @20px;
    }
  }
  .ui.message {
    display: flex;
    background: @white;
    .icon {
      margin-right: @24px;
    }
    .title {
      font-size: @16px;
      font-weight: bold;
    }
    .description {
      margin-top: @13px;
      font-size: @12px;
      color: @grey;
    }
  }
  .vote-cast-as {
    margin: @21px 0 @40px 0;
    display: flex;
    flex-direction: row;
    align-items: start;
    .kiln-icon { margin: @2px @12px 0 0; }
    > .item {
      margin-right: @47px;
      > .title {
        font-size: @16px;
        font-weight: bold;
      }
    }
  }
  .ledger-device-status {
    text-align: center;
    .mark {
      position: relative;
      right: @12px;
      top: -@15px;
      > .icon {
        background-color: @white;
      }
    }
  }
  .proposals {
    margin: 0 -@10px;
    .no-proposals { font-size: @16px; }
    table {
      margin-top: @20px;
      width: 100%;
      text-align: center;
      border-spacing: @8px;
      th:first-child, td:first-child { text-align: left; }
      thead {
        margin-bottom: @11px;
        tr > th {
          color: #6a6a6a;
          font-size: @12px;
          font-weight: normal;
        }
      }
      tbody {
        font-weight: bold;
        > tr {
          vertical-align: middle;
          &.filtered { display: none; }
          .ui.button {
            width: unit(76 / @emSize, rem);
            height: @24px;
            line-height: @24px;
            padding: 0;
            margin: 0;
            background-color: @blue;
            color: @white;
            &.pending, &.voted { cursor: auto; }
            &.pending { background-color: #aabfe1; }
            &.voted {
              background-color: @white;
              box-shadow: none;
              color: #98a0ad;
            }
          }
        }
      }
    }
  }
  .vote-buttons {
    text-align: center;
    button {
      margin: 0 @10px;
      width: unit(166 / @emSize, rem);
    }
  }
  .proposal-hash {
    font-weight: bold;
    margin-top: @14px;
  }
  .promote { text-align: center; }
  label {
    display: block;
    margin-bottom: @4px;
  }
  .ui.input > input {
    background-color: #fcfcfc;
  }
}

.amendment-popup {
  width: unit(558 / @emSize, rem);
  padding: @20px 0;
  margin: -0.833em calc(1px ~"-" 1em); // Reverse the padding of the surrounding semui popup
  display: flex;
  > .menu {
    width: unit(238 / @emSize, rem);
    > .item {
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: @5px @20px @9px;
      &.disabled { color: #98a0ad; }
      &:not(.disabled) { cursor: pointer; }
      &.active { background-color: #f8faff; }
      &:not(.active) > .arrow { display: none; }
      > .arrow {
        position: absolute;
        right: @7px;
        top: calc(50% ~"-" @10px);
        height: @20px;
        width: @20px;
      }
      > .title {
        font-size: @13px;
        font-weight: bold;
        > .icon {
          margin-left: @8px;
          font-size: @20px;
          vertical-align: bottom;
        }
      }
      > .date {
        line-height: 1.33;
        font-size: @12px;
        color: #898989;
      }
      > .progress {
        width: 8 * (@12px + @10px);
        > i {
          display: inline-block;
          margin-right: @10px;
          height: @12px;
          width: @12px;
          border-radius: 50%;
          &.completed { background-color: @green; }
          &.current { border: @2px solid @green; }
          &.upcoming { background-color: #e1e6f0; }
        }
      }
    }
    > .estimated-date {
      margin: @12px 0 0 @20px;
      font-size: 12px;
      color: #898989;
    }
  }
  > .detail {
    position: relative;
    width: unit(318 / @emSize, rem);
    border-left: solid @2px #f5f5f5;
    padding: 0 @20px;
    > .period {
      font-size: @16px;
      font-weight: bold;
      line-height: 1.5;
      > .cycles {
        font-size: @12px;
        font-weight: normal;
        color: #6a6a6a;
        margin-left: @8px;
      }
    }
    .positive { color: @green; }
    .negative { color: @red; }
    > dl {
      dt { margin-top: @18px; }
      dd { margin-left: 0; }
    }
    th, dt {
      font-weight: normal;
      color: #6a6a6a;
      font-size: @12px;
    }
    td, dd {
      font-weight: bold;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    table { width: 100%; }
    > table {
      border-spacing: 0 @10px;
      td:first-child, th:first-child {
        text-align: left;
        max-width: unit(150 / @emSize, rem);
      }
      td:last-child, th:last-child {
        text-align: right;
      }
    }
  }
}

.no-proposals {
  color: #898989;
  text-align: center;
  font-weight: bold;
  margin-top: @20px;
}

i.ui.icon.icon-arrow-up.upgrade-icon {
  border-radius: 50%;
  font-size: @10px;
  line-height: @18px;
  height: @18px;
  width: @18px !important;
  background-color: @blue;
  color: @white !important;
}

.ui.publicnodes {
  > .public-node.grid {
    border: @1px solid #CED4DA;
    background: white;
    border-radius: @borderRadius;
    cursor: pointer;

    &:hover {
      box-shadow: 0 @4px @12px 0 rgba(0,0,0,0.1);
    }

    &@{moreMagic5} {
      margin-bottom: @15px !important;
    }

    > .row {
      align-items: center;

      > .column > .description {
        color: @grey;
      }

      > .column > .ui.icon.header {
        margin-bottom: 0;
      }
    }
  }

  > .active .ui.icon.header {
    color: #a6a6a6;
  }

  .ui.icon.header {
    font-size: @14px;
    font-weight: 500;
    color: @primaryColor;

    > i.icon {
      font-size: @25px;
    }
  }

  .header {
    font-weight: bold;
  }
}

.telegram-setup {
  line-height: @19px;

  .error {
    padding-left: @50px;
    padding-right: @50px;
    padding-top: 0;
  }

  li {
    padding-bottom: 1.5em; // TODO: Don't use 'em'
  }

  p {
    padding-top: 1em; // TODO: Don't use 'em'
  }
}

.suggested-fix {
  color: @grey;
  font-size: 90%;
  padding-bottom: @12px;

  > .heading {
    font-weight: bold;
    display: inline;

    &:after {
      content: ": ";
    }
  }

  > .content {
    display: inline;
  }
}

.block-level-error, .block-level-error > a {
  color: #c00;
  font-weight: bold;
}

body {
  height: 100%;
  width: 100%;
  min-width: 70rem;
  overflow-x: auto;
}

.app-frame {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
}

.notification-settings-section {
  margin: @32px @30px;
}

.fake-radio-item {
  cursor: pointer;
  position: relative;
  margin: 1rem 0;
  padding-left: @25px;
  &:before, &:after {
    content: '';
    border-radius: 50%;
    display: block;
    position: absolute;
    left: 0;
    top: @1px;
  }
  &:before {
    width: @18px;
    height: @18px;
    border: @2px solid @blue;
  }
  &:after {
    margin: @4px;
    width: @10px;
    height: @10px;
  }
  &.checked:after {
    background-color: @blue;
  }
  input {
    display: inline;
    width: @60px;
    height: @23px;
    margin: 0 @5px;
    padding-left: @10px;
    border: 1px solid @lightGrey;
    border-radius: 3px;
    color: #c6c6c6;
    background: #fcfcfc;
  }
  &.checked input {
    color: @black;
  }
}

.app-sidebar {
  width: unit(220 / @emSize, rem);
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  background: @sidebarBackground;

  // .ui.basic.segment sets a transparent background
  &.ui.basic.segment {
    background: @sidebarBackground;
  }

  > .ui.basic.segment {
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: unit(30 / @emSize, rem);
    padding-right: unit(30 / @emSize, rem);
    padding-top: 0;
    padding-bottom: 0;
  }

  .app-side-header {
    margin-bottom: 0;
    padding-bottom: 0;

    img.app-logo {
      width: auto;
      margin-right: 0.5em;
      margin-top: 1em;
    }

    .ui.header {
      font-size: unit(22 / @emSize, rem);
    }

    > .ui.vertical.menu {
      margin-top: unit(40 / @emSize, rem);
      margin-bottom: unit(30 / @emSize, rem);

      a:hover {
        text-decoration: none;
      }

      .link.item:only-child {
        background-color: @white;
        border: solid @1px @grey;
        border-radius: @3px;
        box-shadow: 0 @2px @6px 0 rgba(0, 0, 0, 0.1);

        &.active {
          border-color: @blue;
        }
      }
    }
  }

  .app-side-footer > .ui.vertical.menu > a:hover {
    text-decoration: none;
  }
}

.pusher {
  display: flex;
  flex-direction: column;
  height: 100%;

  .ui.segment.vertical.primary {
    display: flex;
    justify-content: space-between;

    padding-top: @6px;
    padding-bottom: @6px;
    padding-left: @30px;
    padding-right: @20px;
    border-bottom-width: @2px;
    background-color: #FEFEFE;


    .ui.circular.label.link {
      cursor: pointer;
      height: @40px;
      font-size: 16px;
      margin-top: 2px;
      &.basic {
        border-color: transparent;
      }
      i.icon-bell {
        margin-right: 0;
      }
    }

    .topbar {
      display: flex;
      align-items: center;

      > .ui.horizontal.list {
        display: flex;
        > .item {
          .withRightIcon {
            display: flex;
            align-items: center;
          }
          &:not(:first-child) {
            margin-left: @40px;
          }

          .metadescription {
            font-weight: normal;
          }

          .content {
            .header {
              font-size: @12px;
              font-weight: normal;
              color: rgba(0, 0, 0, .6);
              padding-bottom: @4px;

              > .ledger {
                height: 1em;
              }
            }
            .description {
              display: flex;
              align-items: center;
              color: black;
              font-weight: bold;
              font-size: @13px;
              .icon {
                margin-left: @8px;
                font-size: @20px;
              }
              .protocol-tooltip {
                white-space: normal;

                p {
                  margin-bottom: @7px;
                }
                .popup {
                  padding: 0.2em 0.8em 0em 0.8em;
                }

                .tooltip-title {
                  color: @grey;
                  font-size: @12px;
                }
                .tooltip-description {
                  .icon {
                    margin-left: 0;
                    font-size: 1.2em;
                  }
                  font-weight: bold;
                  font-size: @12px;
                }
              }
            }
          }
          .ledger {
            margin-top: 0.2em;
          }
        }
      }


      .disconnected-tooltip {
        width: 260px;
        white-space: normal;

        p {
          margin-bottom: @7px;
        }

        .tooltip-title {
          font-weight: bold;
          font-size: @13px;
        }

        .tooltip-description {
          color: @grey;
          font-size: @12px;
        }
      }
    }
  }
}

.icon.circle.healthy-node {
  margin-left: @8px;
  margin-right: @8px;
}

.app-header {
}

.app-content {
  flex-grow: 1;
  &:not(.app-welcome) {
    padding-left: @30px;
    padding-right: @30px;
  }
  overflow: auto;

  &.app-welcome {
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    .welcome-description {
      margin: @30px auto 0;
      width: unit(474 / @emSize, rem);
    }
  }

  h4 {
    margin-bottom: @30px;
  }
}

.ui.segment.app-gutter {
  padding-left: @30px;
  flex-grow: 1;
  overflow-x: hidden;
  overflow-y: auto;
  > .ui.sub.header , > .ui.list > .item {
    margin-top: @12px;
    margin-bottom: @12px;
    padding-top: 0;
    padding-bottom: 0;
    max-width: 100%;
  }
  > .ui.list > .item > .content {
    display: block;
    .header {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;

      .title {
        display: block;
        text-overflow: ellipsis;
        overflow: hidden;
      }
      img {
        height: @10px;
      }
      .ui.bottom.right.popup:before {
        right: @5px;
      }
    }
    .description {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }
  > .ui.button {
    margin-top: @14px;
    margin-bottom: @14px;
  }
  .ui.sub.header {
    color: @grey;
    font-weight: normal;
  }
}

.ui.segment.app-side-footer {
  > .ui.vertical.menu {
    margin-left: -@10px;
    margin-right: -@10px;
    width: calc(100% ~"+" @20px);
    > .link.item:only-child {
      font-size: @13px;
      line-height: @18px;
      padding-left: @10px;
      padding-right: @10px;
      padding-top: @5px;
      padding-bottom: @5px;
      .icon {
        margin-top: unit(2.5 / @emSize, rem);
      }
    }
  }
}

.ui.block.list {
  > .link.item {
    cursor: pointer;
  }
  > .item {
    background-color: @offWhite;
    height: unit(42 / @emSize, rem);
    padding: unit(6 / @emSize, rem) unit(9 / @emSize, rem) !important;
    margin: unit(2.5 / @emSize, rem) 0;
    line-height: unit(30 / @emSize, rem);
    border-radius: unit(3 / @emSize, rem);
    font-size: unit(14 / @emSize, rem);

    &.link:hover {
      background-color: #f3f4f6;
    }

    > span {
      dt {
        display: inline;
      }

      dt::after {
        content: ":";
      }

      dd {
        font-weight: bold;
        display: inline;
        margin-inline-start: @5px;
      }
      >.icon-check {
        width: unit(24 / @emSize, rem);
        position: relative;
        margin-right: unit(22 / @emSize, rem);
        height: 100%;
        float: left;

        &.active:before {
          background-color: @blue;
          color: @white;
        }

        &:before {
          display: block;
          position: absolute;
          top: 50%;
          margin-top: unit(-12 / @emSize, rem);
          width: unit(24 / @emSize, rem);
          height: unit(24 / @emSize, rem);
          line-height: unit(24 / @emSize, rem);
          text-align: center;
          border-radius: 50%;
          background-color: #d8dce6;
          color: @slate;
        }
      }
    }
  }
}

.app-right {
  height: 100%;
  display: flex;
  flex-direction: column;
  flex-grow: 1;

  .ui.sidebar.vertical.menu {
    @sidebar-horizontal-padding: @30px;
    padding: @20px @sidebar-horizontal-padding;
    display: flex;

    .sidebar-title {
      padding-bottom: @10px;
      .header.floated {
        font-size: @20px;
        margin-right: 0;
        > .icon {
          ._link-like();
          font-size: @25px;
          margin-right: 0;
        }
      }
    }

    .divider {
      margin-top: @15px;
      margin-bottom: @20px;
      margin-left: -@sidebar-horizontal-padding;
      margin-right: -@sidebar-horizontal-padding;
      border-top-width: @2px;
    }

    .no-notifications {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100%;
      color: @grey;
      font-size: @20px;
    }

    .ui.segment.vertical.app-notifications-list {
      padding-top: 0;

      .ui.message.app-notification {
        display: flex;
        flex-direction: column;
        color: @black;
        font-size: @12px;

        * {
          text-overflow: ellipsis;
          overflow: hidden;
        }

        > * {
          margin-top: @3px;
          margin-bottom: @3px;
        }

        .header {
          color: @black;
          font-size: @20px;
          line-height: 1.5;
        }

        .alert-entity {
          font-size: @14px;
          label.secondary-label { font-size: @12px; }
        }

        label {
          font-weight: bold;
          margin-right: 1em;
        }

        .secondary-label {
          font-weight: normal;
          font-style: italic;
          color: @grey;
        }
      }
    }
  }
}

/* .ui.header > img sets a vertical-align */
.ui.header > img.app-logo {
  height: 0.74em; // TODO: Don't use 'em'
  vertical-align: baseline;
}

img.credits-obsidian {
  width: unit( (110 / @emSize), rem);
  background: white;
  border-color: white;
  border-radius: @2px;
  border-style: solid;
  border-width: @5px @10px;
  margin-left: @7px;
}

i.ui.icon-letter.icon {
  font-size: 18px;
}

.notifications-subsection {
  > .ui.header > .ui.toggle label {
    > .icon {
      margin-left: 1em;
      margin-right: 1em;
    }
    .secondary-heading();
    margin-top: @20px;
    margin-bottom: @20px;
  }
  > .edit-link {
    margin-top: @15px;
    margin-bottom: @15px;

    a {
      cursor: pointer;
    }
  }
  margin-top: @30px;
  margin-bottom: @30px;

  .ui.header {
    > .ui.icon-letter.icon {
      font-size: 18px;
      vertical-align: -10%;
      }
    > .ui.icon-telegram.icon {
      font-size: 16px;
      vertical-align: -3%;
      }
    }

  .small.ui.header + .notification-settings-description {
    margin-top: @10px;
  }

  .notification-settings-description {
    .fine-print();
    font-size: @12px;
    margin-top: @30px;
    margin-bottom: @20px;
  }

  .ui.button.fluid {
    width: 200px;
  }

  .ui.form .fields {
    margin-left: 0;
    margin-right: 0;
    margin-bottom: @10px;

    .inline.field {
      padding-left: 0;
      padding-right: 0;
      margin-right: @20px;
    }

    .field.wide {
      padding-left: 0;
      padding-right: 0;
      margin-right: @30px;

      input {
        padding-left: @10px;
        padding-right: @15px;
      }

      i.dropdown.icon {
        color: @blue;
        font-size: @20px;
        padding: @7px;
      }
    }

    .email-buttons {
      > a.remove {
        cursor: pointer;
        font-weight: bold;

        &:hover {
          text-decoration: none;
        }
      }

      > a.send-test {
        cursor: pointer;
        margin-left: @20px;
      }
    }
  }
}

.fancy-tez {
  font-weight: bold;
  > .tez {
    margin-left: 0.3rem;
    color: @grey;
  }
}

.tez {
  font-family: 'tezos-icons';
  font-weight: normal;
  vertical-align: bottom;
  font-size: 0.9em; // glyphs in this font are slightly too big to look right alongside other text without this
}

.settings-table {
  margin-top: @15px;
  margin-bottom: @15px;

  td, th {
    text-align: left;
    vertical-align: top;
    // No way to do interior-only border-spacing, so instead use this on
    // successive children. Use padding because no margin on table cells.
    padding-left: @40px;
  }
  // `rowspan` means `:first-child` doesn't indicate visually first cell of row.
  // Use `.visually-second` on such second column first children as a
  // workaround.
  td:first-child:not(.visually-second), th:first-child:not(.visually-second) {
    padding-left: 0px;
  }
}

.soft-heading {
  .secondary-heading();
}

.version-section {
  margin-top: @35px;
  > .check-for-updates {
    padding-top: @10px;

    > a {
      cursor: pointer;
      padding-right: @27px;
    }
  }
}

.notifications-section {
  > .ui.header:first-child {
    margin-top: @64px;
  }
}

.ui.list > .item.bullet-before {
  position: relative;

  > .icon.circle.tiny {
    position: absolute;
    right: 100%;
    margin-right: @7px;
    line-height: 2.4em; // To position the dot correctly.
  }

  > .icon + .content {
    padding-left: 0;
  }
}

.ui.form {
  .feedback {
    margin-top: @30px;
    margin-bottom: @15px;

    i {
      margin-right: @10px;
      font-size: @15px;
      font-weight: bold;
    }
  }
}

.ui.active.inline.loader { z-index: auto; }

.ui.loader.blue {
  &:after {
    border-top-color: @blue;
  }
  &:before {
    border-color: fade(@blue, 10%);
  }
}

.dashboard-section > .dashboard-section-overview {
  display: flex;

  .dashboard-section-overview-icon {
    .icon {
      margin-right: @24px;
    }
  }

  .dashboard-section-overview-body {
    flex: 1;
    font-size: @12px;

    .ui.header {
      .ui.loader {
        margin-right: @10px;
      }
    }

    .alert-entity {
      margin-top: @2px;
      margin-bottom: @16px;

      label:not(.secondary-label) {
        margin-right: @9px;
        font-weight: 700;
      }
      label.secondary-label {
        color: @grey;
      }
    }

    .description {
      margin-top: @13px;
      font-size: @12px;
      color: @grey;

      .buttons {
        display: flex;
        justify-content: flex-end;
      }
      .fix {
        margin-top: @10px;
      }
    }
  }
}

.internal-subtitle {
  display: flex;
  margin-top: @4px;

  img {
    height: @10px;
    margin-right: @10px;
    font-size: @10px;
  }
  div {
    height: @10px;
  }
}

.dashboard-section > .ui.cards {
  margin-left: 0;
  margin-right: 0;

  > .ui.card.node-tile {
    width: unit(200 / @emSize, rem);
    .generating-icons {
      margin-top: @15px;
      margin-bottom: @19px;
      .icon {
        color: #d8dce6;
        margin-right: @15px;
        width: @28px;
      }
    }
    .tile-header-spacing {
      margin-bottom: @24px;
    }
    .content > .title {
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  > .ui.card.baker-tile {
    width: unit(430 / @emSize, rem);

    .divider { width: auto !important; }

    .internal-subtitle + .secondary-name {
      margin-top: @8px;
    }

    .ui.loader {
      margin-right: @6px;
    }
  }

  > .ui.card.dashboard-tile {
    box-shadow: none;

    margin-left: 0;
    margin-right: @30px;

    > .content {
      flex-grow: 0;

      padding-left: @15px;
      padding-right: @15px;
      padding-top: @2px;
      padding-bottom: @17px;

      border-radius: @2px !important;
      border: solid @1px #cacaca !important;

      font-size: @12px;
      line-height: 1.5;

      > .menu-section {
        text-align: right;

        .icon {
          ._link-like();
          font-size: @20px;
          color: @grey;
          margin: 0;
        }

        .ui.popup {
          top: @15px;
          right: unit(-71 / @emSize, rem); // Value determined experimentally
          width: unit(200 / @emSize, rem);
          text-align: left;

          > .link.list .item {
            ._link-like();
            color: @blue;
            font-size: @14px;
            line-height: 2.86;
          }
        }
      }

      > .title {
        font-size: @14px;
        font-weight: bold;
        line-height: 1.3;
        .baker-vote-popup {
          display: inline-block;
          margin-left: @15px;
          .detail { color: #898989; }
        }
        text-overflow: ellipsis;
        white-space: nowrap;

        .circle.icon {
          font-size: @8px;
          vertical-align: 15%;
        }
      }

      > .ui.message {
        margin-top: @10px;
        font-weight: bold;
        font-size: @13px;
        color: black;
        line-height: 1;

        padding-top: @12px;
        padding-bottom: @11px;  // Because it doesn't look right without this.
        padding-left: @12px;
        padding-right: @12px;

        border-radius: @3px;
        box-shadow: none;
      }

      > .ui.message.red {
        border: solid @1px @red;
        background-color: #fff5f5;
      }

      > .ui.message.orange {
        border: solid @1px @orange;
        background-color: #fff9f5;
      }

      > .ui.message.blue {
        border: solid @1px @blue;
        background-color: #f5f9ff;
      }

      > .divider {
        width: unit(170 / @emSize, rem);
        height: @1px;
        background-color: #eaeaea;
        margin-top: @10px;
        margin-bottom: @7px;
      }

      dl {
        margin-block-start: 0;
        margin-block-end: 0;

        > div {
          > dt {
            display: inline;
          }

          > dt::after {
            content: ":";
          }

          > dd {
            font-weight: bold;
            display: inline;
            margin-inline-start: @5px;
          }
        }
      }

      table.baker-balance {
        border-spacing: 0;
        > tr > td:first-child::after {
          content: ":";
        }
        > tr > td.baker-balance-whole {
          padding-right: 0;
          text-align: right;
          font-weight: bold;
        }
        > tr > td.baker-balance-part {
          padding-left: 0;
          text-align: left;
          font-weight: bold;
        }
        .tez {
          margin-left: @5px;
          color: @grey;
        }
      }

      table.participation-info {
        border-spacing: 0;
        > tr > td:first-child::after {
          content: ":";
        }
        > tr > td:not(:first-child) {
          padding-right: 0;
          text-align: right;
          font-weight: bold;
        }
        .tez {
          margin-left: @5px;
          color: @grey;
        }
      }

      > .peer-count {
        font-size: @16px;
      }

      > .stats {
        display: flex;
        flex-wrap: wrap;
        flex-direction: row;
        justify-content: space-between;
        margin: 0;
        padding: 0;

        .icon {
          margin-right: 0;
          font-size: @9px;
          color: @grey;
        }

        > .column {
          display: flex;
          flex-direction: column;

          &.heading {
            color: @grey;
            text-align: right;
          }

          > .cell {
            box-sizing: border-box;
            overflow: hidden; // Or flex might break
            list-style: none;
            border: none;
          }
        }
      }
    }
  }
}

h4.dashboard-section-title {
  text-transform: uppercase;
  margin-top: @20px;
  margin-bottom: @20px;
  color: @slate;
  font-size: @14px;
}

.explanation {
  color: @grey;
  font-size: @12px;
}

.modal-box > .content {
  > .ui.header {
    margin-bottom: @30px;
  }

  > .ui.grid {
    max-height: 80vh;
    overflow: auto;

    > .column:not(:first-child) {
      padding-left: 30px;
    }
    > .column:not(:last-child) {
      padding-right: 30px;
    }

    .add-internal {
      width: unit(279 / @emSize, rem);
      img.app-logo {
        margin-bottom: -@3px;
        margin-right: @12px;
      }
    }

    .add-external {
      width: unit(305 / @emSize, rem);
    }

    .add-public {
      width: unit(379 / @emSize, rem);
    }

    .start-baking {
      width: unit(279 / @emSize, rem);
      > .ui.button {
        margin-top: unit(22 / @emSize, rem);
      }
    }

    .connect-baker {
      width: unit(413 / @emSize, rem);
    }

    .column > .ui.header {
      margin-bottom: @10px;
      font-weight: normal;
    }

    .explanation {
      margin-top: @5px;
      margin-bottom: @20px;
      lineHeight: @16px;
    }

    .field > label > .explanation {
      margin-bottom: @10px;
    }
  }
}

.modal-box.add-baker.ledger-setup-steps {
  width: unit(949 / @emSize, rem);
  > .content { display: flex; }
  .workflow {
    flex-grow: 1;
    .ui.header {
      text-align: center;
      &:first-child { margin-top: 0; }
    }
    .explanation { margin-bottom: @14px; }
    .select-address {
      .fancy-tez { float: right; }
      .ui.block.list {
        margin: @20px 0;
        .loader { margin-right: @10px; }
        .item { margin: @5px 0; }
      }
    }
    .rejected {
      font-size: @16px;
      font-weight: bold;
      padding: @20px;
      border: 1px solid @lightGrey;
      white-space: nowrap;
      .icon-x {
        font-size: inherit;
        margin-right: @12px;
      }
    }
    .start-baking-message {
      &.centered {
        text-align: center;
        padding: @20px;
        .icon { margin-right: @20px; }
        .header:only-child {
          margin-bottom: 0;
        }
      }
      margin: @20px 0 @25px;
      text-align: left;
      border: @1px solid @lightGrey;
      border-radius: @3px;
      padding: @18px @20px @8px unit(61 / @emSize, rem);
      position: relative;
      .header {
        font-size: @16px;
        font-weight: bold;
        margin-bottom: @9px;
      }
      a { word-break: break-word; }
      .icon-warning {
        position: absolute;
        top: @20px;
        left: @20px;
      }
    }
    .tx-fee-input {
      margin: @4px auto @30px;
      width: unit(170 / @emSize, rem);
    }
    .central {
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      text-align: center;
    }
    .explanation {
      text-align: left;
      &.centered { text-align: center; }
      > ol {
        list-style-position: inside;
        padding-left: 0;
      }
    }
  }

  .progress {
    flex-shrink: 0;
    width: unit(237 / @emSize, rem);
    height: unit(520 / @emSize, rem);
    margin-right: @50px;
    border-right: @1px solid @lightGrey;
    > h4.ui.header {
      font-size: @16px;
      line-height: @24px;
    }
    > ol {
      font-size: @14px;
      > li {
        position: relative;
        list-style-position: inside;
        margin: @20px 0;
        color: @grey;
        font-weight: bold;
        &.current, &.done {
          color: @black;
        }
        &.done:before {
          width: @10px;
          height: @10px;
          color: @blue;
          font-family: tezos-icons;
          font-size: @10px;
          content: "\e905";
          position: absolute;
          left: -@20px;
        }
        > .extra {
          > img {
            display: block;
            width: unit(83 / @emSize, rem);
          }
          color: @grey;
          font-weight: normal;
          font-size: @12px;
          line-height: @16px;
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
      }
    }
  }
}

.modal-box.add-baker {
  width: unit(766 / @emSize, rem);
  max-width: none;

  h3 {
    font-size: unit(24 / @emSize, rem);
    margin-bottom: @10px;
  }

  .basic.small.segment {
    margin-top: @10px;
    margin-bottom: @20px;
  }

  .ui.button.primary {
    margin-top: unit(40 / @emSize, rem);
    /* TODO make this padding standard for all primary buttons? */
    padding-left: unit(50 / @emSize, rem);
    padding-right: unit(50 / @emSize, rem);
    margin-left: auto;
    margin-right: auto;
    display: block;
  }

  .ledger {
    width: unit(100 / @emSize, rem);
    position: relative;
    margin: @15px auto;
    > .icon {
      position: absolute;
      top: -@10px;
      right: -@10px;
      border-radius: 50%;
      background-color: @white;
      height: @20px;
      width: @20px;
      line-height: @20px;
      font-size: @9px;
    }
    > img {
      display: block;
      width: 100%;
    }
  }

  .ledger-name {
    text-align: center;
    color: @grey;
    font-size: @12px;
    margin-top: -@16px;
    margin-bottom: @10px;
  }

  h5.ui.header {
    margin: @20px 0;
    > .icon {
      font-size: 1em;
      vertical-align: text-bottom;
    }
  }

  .prompt-text {
    font-size: @16px;
    line-height: @24px;
    margin: @20px auto;
  }

  .ui.header > .ui.loader {
    margin-right: @14px;
  }

  &.ledger-disconnected {
    width: unit(422 / @emSize, rem);
  }

  &.launch-node {
    width: unit(660 / @emSize, rem);
  }

  &.launch-node, &.disclaimer {
    .content {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      .checkbox {
        margin-top: @20px;
      }
    }
  }

  &.disclaimer {
    width: unit(660 / @emSize, rem);
    .explanation {
      font-size: @14px;
      line-height: @22px;
      color: @black;
      text-align: left;
    }
    .ui.error.message { margin-bottom: -@20px; }
  }

  &.ledger-prompt {
    width: unit(593 / @emSize, rem);
    text-align: center;
    h5.ui.header {
      font-size: @20px;
      line-height: @30px;
      .ui.loader {
        margin-right: @14px;
      }
    }
    h6 {
      font-size: @16px;
      margin: @20px auto 0 auto;
    }
  }

  &.set-high-water-mark {
    width: unit(495 / @emSize, rem);
    text-align: center;
    h6.ui.header {
      font-size: @16px;
      margin: @20px 0;
    }
  }

  &.set-high-water-mark-prompt {
    width: unit(593 / @emSize, rem);
    text-align: center;
  }

  &.set-high-water-mark-set {
    width: unit(558 / @emSize, rem);
    text-align: center;
  }
}

.modal-box.add-node {
  width: unit(680 / @emSize, rem);

  .ui.button.primary {
    display: inline-block;
    width: 100%;
  }
}

.modal-box.start-node {
  width: 940px;
  .back-button {
    ._link-like();
    margin-bottom: @15px;
    color: @blue;
    .icon {
      transform: translate(0px, 2px);
    }
  }

  .ui.header {
    margin-bottom: 10px;
  }

  .ui.button.primary {
    margin-top: 10px;
    /* TODO make this padding standard for all primary buttons? */
    padding-left: unit(50 / @emSize, rem);
    padding-right: unit(50 / @emSize, rem);
    margin-left: auto;
    margin-right: auto;
    display: block;
  }
  .file-selection > input {
    display: none;
  }
}

.modal-box.show-error-log {
  width: unit(560 / @emSize, rem);

  .log-message {
    overflow: auto;
    max-height: 400px;
  }

  .ui.button.primary {
    margin-top: unit(40 / @emSize, rem);
    /* TODO make this padding standard for all primary buttons? */
    padding-left: unit(50 / @emSize, rem);
    padding-right: unit(50 / @emSize, rem);
    margin-left: auto;
    margin-right: auto;
    display: block;
  }
}

.modal-box.confirmation {
  width: unit(658 / @emSize, rem);
  .ui.header {
    font-size: @24px;
    line-height: @36px;
    margin-bottom: @20px;
    .ui.icon {
      font-size: @28px;
      margin-right: @25px;
    }
  }
  .verify-top-message {
    &.centered {
      text-align: center;
      padding: @20px;
      .icon { margin-right: @20px; }
      .header:only-child {
        margin-bottom: 0;
      }
    }
    margin: @20px 0 @25px;
    text-align: left;
    border: @1px solid @lightGrey;
    border-radius: @3px;
    padding: @18px @20px @8px unit(61 / @emSize, rem);
    position: relative;
    .header {
      font-size: @16px;
      font-weight: bold;
      margin-bottom: @9px;
    }
    a { word-break: break-word; }
    .icon-warning {
      position: absolute;
      top: @20px;
      left: @20px;
    }
  }
  .field {
    margin: @10px;
    .detail {
      font-size: @12px;
      color: #6a6a6a;
    }
  }
}

.internal-node-tile-body {
  .ui.row {
    margin-top: @10px;
    margin-bottom: @10px;

    .ui.error.message {
      margin-top: @10px;
      font-weight: bold;
      font-size: @13px;
      color: black;
      line-height: 1;

      padding-top: @12px;
      padding-bottom: @11px;  // Because it doesn't look right without this.
      padding-left: @12px;
      padding-right: @12px;

      border-radius: @3px;
      border: solid @1px #ff0000;
      box-shadow: none;
      background-color: #fff5f5;
    }
  }
  .ui.button {
    margin-top: @20px;
    margin-bottom: @20px;
    .icon { transform: translate(-2px, 2px); }
  }
}

.dashboard-section.dashboard-section-global-alerts {
  margin-left: @30px;
  margin-right: @30px;
  margin-top: @30px;
}

/* vim: set syntax=less : */
