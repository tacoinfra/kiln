name: common
version: 0.1
license: BSD3
copyright: (c) 2018 Obsidian Systems LLC, 2020-2021 TQ Tezos, 2021-2022 Oxhead Alpha
author: Obsidian Systems LLC
maintainer: Tezos Kiln <maintainer@tezos-kiln.org>
stability: Experimental
build-type: Simple
cabal-version: >=1.8

flag docker
  description: Is being built for docker
  default: False

flag linux-package
  description: Is being built for a Linux package (Debian, Redhat, etc.)
  default: False

library
  hs-source-dirs: src

  build-depends:
      aeson
    , IntervalMap
    , attoparsec
    , base
    , base16-bytestring
    , base58-bytestring
    , binary
    , bytestring
    , cases
    , constraints
    , constraints-extras
    , containers
    , cryptonite
    , data-default
    , database-id-class
    , deepseq
    , dependent-map
    , dependent-sum
    , dependent-sum-aeson-orphans
    , dependent-sum-template
    , either
    , file-embed
    , functor-infix
    , hashable
    , hashing
    , http-types
    , lens
    , memory
    , modern-uri
    , monoidal-containers
    , mtl
    , obelisk-generated-static
    , obelisk-route
    , reflection
    , reflex
    , reflex-dom-core
    , rhyolite-common
    , rhyolite-datastructures
    , rhyolite-frontend
    , safe
    , safe-exceptions
    , semialign
    , scientific
    , split
    , tagged
    , template-haskell
    , text
    , these
    , time
    , transformers-compat
    , universe
    , universe-base
    , universe-dependent-sum
    , unordered-containers
    , uri-encode
    , witherable
    , validation
    , vector
    , vector-instances
    , writer-cps-mtl

  exposed-modules:
    Common
    Common.Alerts
    Common.Api
    Common.App
    Common.AppendIntervalMap
    Common.Config
    Common.Distribution
    Common.HeadTag
    Common.Route
    Common.Schema
    Common.Snapshot
    Common.Tez
    Common.URI
    Common.Vassal
    Common.WrappedShow1
    ExtraPrelude

    Tezos.Types
    Tezos.Unsafe

    Tezos.Common.Accusation
    Tezos.Common.BalanceUpdate
    Tezos.Common.Ballot
    Tezos.Common.Base16ByteString
    Tezos.Common.Base58Check
    Tezos.Common.Binary
    Tezos.Common.Block
    Tezos.Common.BlockHeader
    Tezos.Common.Chain
    Tezos.Common.Contract
    Tezos.Common.Fitness
    Tezos.Common.IsBootstrapped
    Tezos.Common.Json
    Tezos.Common.Ledger
    Tezos.Common.Level
    Tezos.Common.NetworkStat
    Tezos.Common.NodeConfig
    Tezos.Common.NodeRPC.Types
    Tezos.Common.PeriodSequence
    Tezos.Common.PublicKey
    Tezos.Common.PublicKeyHash
    Tezos.Common.ShortByteString
    Tezos.Common.Tez

    Tezos.CrossCompat.Account
    Tezos.CrossCompat.Block
    Tezos.CrossCompat.Vote

    Tezos.Genesis.Block

    Tezos.Base.Account
    Tezos.Base.Block
    Tezos.Base.Level
    Tezos.Base.Operation
    Tezos.Base.ProtocolConstants
    Tezos.Base.Types
    Tezos.Base.Unsafe
    Tezos.Base.Vote

  ghc-options: -Wall -fno-warn-unused-do-bind -fwarn-tabs -funbox-strict-fields -O2 -fprof-auto-calls -fexpose-all-unfoldings

  if flag(docker)
    cpp-options: -DDISTRO_DOCKER
  else
    if flag(linux-package)
      cpp-options: -DDISTRO_LINUX_PACKAGE
  default-extensions: StrictData
