-- Initial tezos-bake-monitor.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                tezos-bake-monitor
version:             0.1.0.0
synopsis:            A wrapper for the baking client which monitors the output and provides statistics via a webserver.
-- description:         
license:             BSD3
license-file:        LICENSE
author:              Obsidian Systems
maintainer:          cale.gibbard@obsidian.systems
-- copyright:           
-- category:            
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

executable tezos-bake-monitor
  main-is:             BakeMonitor.hs
  -- other-modules:       
  other-extensions:    TemplateHaskell, OverloadedStrings
  build-depends:
    tezos-bake-monitor-lib,
    base >=4.10 && <4.11,
    process >=1.6 && <1.7,
    async,
    bytestring,
    text,
    aeson,
    snap,
    lens,
    time,
    mtl,
    safe,
    http-client,
    http-client-tls,
    http-types,
    optparse-applicative >=0.14,
    lens-aeson
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options: -threaded -rtsopts -Wall
