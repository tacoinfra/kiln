-- Initial tezos-bake-monitor.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                tezos-bake-monitor-lib
version:             0.1.0.0
synopsis:            Shared types and code between tezos-bake-monitor and tezos-bake-central.
-- description:         
license:             BSD3
license-file:        LICENSE
author:              Obsidian Systems
maintainer:          cale.gibbard@obsidian.systems
-- copyright:           
-- category:            
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

library
  exposed-modules:
    Tezos.BakeMonitor.Types
    Tezos.NodeRPC
  other-extensions: TemplateHaskell, OverloadedStrings
  build-depends:
    aeson,
    async,
    bytestring,
    http-client,
    http-types,
    lens,
    lens-aeson,
    mtl,
    process,
    semigroups,
    snap,
    text,
    time,
    base
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options: -Wall

executable tezos-test-bake-monitor-rpc
  main-is:             Test.hs
  hs-source-dirs:      src-bin
  build-depends:
    mtl,
    tezos-bake-monitor-lib,
    http-client,
    http-client-tls,
    base
  ghc-options: -Wall
