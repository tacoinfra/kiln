-- Initial tezos-bake-monitor.cabal generated by cabal init.  For further 
-- documentation, see http://haskell.org/cabal/users-guide/

name:                tezos-bake-monitor-lib
version:             0.1.0.0
synopsis:            Shared types and code between tezos-bake-monitor and tezos-bake-central.
-- description:         
license:             BSD3
license-file:        LICENSE
author:              Obsidian Systems
maintainer:          cale.gibbard@obsidian.systems
-- copyright:           
-- category:            
build-type:          Simple
extra-source-files:  ChangeLog.md
cabal-version:       >=1.10

library
  exposed-modules:
    Tezos.Account
    Tezos.BalanceUpdate
    Tezos.Base16ByteString
    Tezos.Base58Check
    Tezos.Block
    Tezos.BlockHeader
    Tezos.Contract
    Tezos.Fitness
    Tezos.Json
    Tezos.Level
    Tezos.Lenses
    Tezos.Micheline
    Tezos.NodeRPC
    Tezos.NodeRPC.Network
    -- Tezos.NodeRPC.Schema
    Tezos.NodeRPC.Types
    Tezos.Operation
    Tezos.PeriodSequence
    Tezos.ProtocolConstants
    Tezos.PublicKey
    Tezos.PublicKeyHash
    Tezos.Signature
    Tezos.TestChainStatus
    Tezos.Tez
    Tezos.Types
    Tezos.History
    Data.LCA.Online.Polymorphic
  other-extensions: TemplateHaskell, OverloadedStrings
  build-depends:
    aeson,
    async,
    base16-bytestring,
    base58-bytestring,
    bytestring,
    cases,
    containers,
    cryptohash,
    cryptonite,
    groups,
    http-client,
    http-types,
    lens,
    lens-aeson,
    memory,
    mtl,
    process,
    scientific,
    semigroups,
    template-haskell,
    text,
    time,
    unordered-containers,
    vector,
    safe,
    base
  hs-source-dirs:      src
  default-language:    Haskell2010
  ghc-options: -Wall

executable tezos-lib-smoketest
  main-is:             Test.hs
  hs-source-dirs:      src-bin
  build-depends:
    tezos-bake-monitor-lib,
    mtl,
    http-client,
    http-client-tls,
    text,
    terminal-progress-bar,
    containers,
    base
  ghc-options: -Wall
