name: tezos-bake-monitor-lib
version: 0.1.0.0
synopsis: Shared types and code between tezos-bake-monitor and tezos-bake-central.
-- description:
license: BSD3
license-file: LICENSE
author: Obsidian Systems LLC
maintainer: maintainer@obsidian.systems
-- copyright:
-- category:
build-type: Simple
extra-source-files: CHANGELOG.md
cabal-version: >=1.10

library
  exposed-modules:
    -- Tezos.NodeRPC.Schema
    Data.LCA.Online.Polymorphic
    Tezos.V004.Account
    Tezos.V004.BalanceUpdate
    Tezos.V004.Base16ByteString
    Tezos.V004.Base58Check
    Tezos.V004.Binary
    Tezos.V004.Block
    Tezos.V004.BlockHeader
    Tezos.V004.Chain
    Tezos.V004.Checkpoint
    Tezos.V004.Contract
    Tezos.V004.Envelope
    Tezos.V004.Fitness
    Tezos.V004.Json
    Tezos.V004.Lenses
    Tezos.V004.Ledger
    Tezos.V004.Level
    Tezos.V004.Micheline
    Tezos.V004.Michelson
    Tezos.V004.NodeRPC.Class
    Tezos.V004.NodeRPC.Sources
    Tezos.V004.NodeRPC.Types
    Tezos.V004.Operation
    Tezos.V004.PeriodSequence
    Tezos.V004.ProtocolConstants
    Tezos.V004.PublicKey
    Tezos.V004.PublicKeyHash
    Tezos.V004.Signature
    Tezos.V004.ShortByteString
    Tezos.V004.TestChainStatus
    Tezos.V004.Tez
    Tezos.V004.Types
    Tezos.V004.Vote

    Tezos.V005.Account
    Tezos.V005.BalanceUpdate
    Tezos.V005.Base16ByteString
    Tezos.V005.Base58Check
    Tezos.V005.Binary
    Tezos.V005.Block
    Tezos.V005.BlockHeader
    Tezos.V005.Chain
    Tezos.V005.Checkpoint
    Tezos.V005.Contract
    Tezos.V005.Envelope
    Tezos.V005.Fitness
    Tezos.V005.Json
    Tezos.V005.Lenses
    Tezos.V005.Ledger
    Tezos.V005.Level
    Tezos.V005.Micheline
    Tezos.V005.Michelson
    Tezos.V005.NodeRPC.Class
    Tezos.V005.NodeRPC.Sources
    Tezos.V005.NodeRPC.Types
    Tezos.V005.NodeRPC.CrossCompat
    Tezos.V005.Operation
    Tezos.V005.PeriodSequence
    Tezos.V005.ProtocolConstants
    Tezos.V005.PublicKey
    Tezos.V005.PublicKeyHash
    Tezos.V005.Signature
    Tezos.V005.ShortByteString
    Tezos.V005.TestChainStatus
    Tezos.V005.Tez
    Tezos.V005.Types
    Tezos.V005.Vote
  other-modules:
    Paths_tezos_bake_monitor_lib
  build-depends:
      base
    , aeson
    , async
    , binary
    , base16-bytestring
    , base58-bytestring
    , bytestring
    , cases
    , containers
    , cryptohash
    , cryptonite
    , deepseq
    , dependent-sum
    , functor-infix
    , groups
    , hashable
    , hashing
    , http-types
    , lens
    , memory
    , modern-uri
    , mtl
    , process
    , safe
    , safe-exceptions
    , scientific
    , semigroups
    , tagged
    , template-haskell
    , text
    , time
    , unordered-containers
    , vector
  hs-source-dirs: src
  default-language: Haskell2010
  ghc-options: -Wall -Werror

test-suite test
  default-language:
    Haskell2010
  type:
    exitcode-stdio-1.0
  hs-source-dirs:
    tests
  main-is:
    test.hs
  build-depends:
      base >= 4 && < 5
    , tezos-bake-monitor-lib
    , aeson
    , aeson-pretty == 0.8.*
    , bytestring
    , base16-bytestring
    , pretty
    , pretty-show
    , Diff
    , tasty
    , tasty-hunit
    , text

  
